{
  "name": "spendback",
  "version": "0.0.1",
  "private": true,
  "description": "온디바이스 LLM이 소비 회고를 써 주는 Android 가계부",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@eeennsu/native": "0.4.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.7.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "14.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lightningcss": "1.30.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "test-renderer": "1.2.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "llama.rn"
    ],
    "packageExtensions": {
      "react-native-css@3.0.7": {
        "peerDependenciesMeta": {
          "@expo/metro-config": {
            "optional": true
          }
        }
      }
    }
  }
}
